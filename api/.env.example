# Flyover Golf API
NODE_ENV=development
PORT=3000

# Comma-separated origins allowed to call the API.
# Local development defaults are already allowed by config.
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

# foreUP
# Fill these only after Flyover receives authorized API access.
FOREUP_API_BASE_URL=
FOREUP_API_KEY=

# Club Caddie
# Fill these only after Flyover receives authorized API access.
CLUB_CADDIE_API_BASE_URL=
CLUB_CADDIE_API_KEY=
